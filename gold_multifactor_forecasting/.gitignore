# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/

# IDE / OS
.DS_Store
.idea/
.vscode/

# Local data: Wind/licensed or derived from licensed data.
# Keep these local unless you have explicit redistribution permission.
data/raw/*.xlsx
data/raw/*.xls
data/processed/*.csv
data/processed/*.parquet
data/processed/*.json

# Downloaded external data can always be rebuilt.
data/external/*.csv
data/external/*.json

# Results
results/**/*.csv
results/**/*.json
results/**/*.png
results/**/*.xlsx

# Keep directory placeholders/docs
!data/raw/README.md
!data/processed/.gitkeep
!data/external/.gitkeep
!results/**/.gitkeep
