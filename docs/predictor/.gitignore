# Secrets — never commit the Twelvedata API key
.env

# Raw / intermediate data (regenerated by the pipeline; no secrets inside)
data/*.csv
# Exception: keep the gold history fallback so the GitHub Action can run even before TD_KEY secret is added
!data/gold_history.csv
# Exception: central-bank net-purchase source data (curated, not regenerated by pipeline)
!data/cb_gold.csv
